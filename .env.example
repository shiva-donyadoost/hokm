# HOKM AI PLATFORM — environment template (copy to .env; never commit .env)

# --- Backend ---
APP_ENV=development            # development | production
APP_ADDR=:8080                 # HTTP listen address
LOG_LEVEL=info                 # debug | info | warn | error

# --- Database (PostgreSQL) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=hokm
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=hokm

# --- Redis ---
REDIS_ADDR=redis:6379

# --- Auth (JWT) ---
JWT_SECRET=generate-a-long-random-secret-here
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# --- Game tuning ---
ROUNDS_TO_WIN=7
TURN_TIMEOUT_SECONDS=60
AI_MOVE_DELAY_MS=600
