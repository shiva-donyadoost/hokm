# HOKM AI PLATFORM â€” environment template (copy to .env; never commit .env)

# --- Backend ---
APP_ENV=development            # development | production
APP_ADDR=:8080                 # HTTP listen address (inside the container)
BACKEND_HOST_PORT=8080         # host publish; launcher remaps if 8080 is excluded
LOG_LEVEL=info                 # debug | info | warn | error

# --- Database (PostgreSQL) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=hokm
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=hokm

# --- Redis ---
REDIS_ADDR=redis:6379

# --- Auth (JWT) ---
JWT_SECRET=generate-a-long-random-secret-here
JWT_ACCESS_TTL=720h
JWT_REFRESH_TTL=720h

# --- Game tuning (see docs/IMPLEMENTATION_PLAN.md Enhancement Wave 2) ---
GAME_HAKEM_SELECTION_TIMEOUT=10s
GAME_CARD_SELECTION_TIMEOUT_FAST=5s
GAME_CARD_SELECTION_TIMEOUT_MEDIUM=10s
GAME_CARD_SELECTION_TIMEOUT_SLOW=15s
GAME_RECONNECT_GRACE_PERIOD=30s
GAME_TRICK_PAUSE=1s
GAME_AI_MOVE_DELAY=1s
GAME_CARD_PLAY_ANIMATION_DURATION=500ms
GAME_TRICK_WINNER_DISPLAY_DURATION=3s
GAME_ALLOWED_ROUND_COUNTS=1,3,5
